{
  "name": "ran/wp-github-release-updater",
  "description": "GitHub Release update integration for WordPress plugins.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-hash": "*",
    "ext-json": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "test:performance": "php tests/Characterization/managed-preflight-performance.php",
    "lint": "phpcs --standard=phpcs.xml --report=summary",
    "analyze": "phpstan analyse --configuration=phpstan.neon --no-progress --debug --memory-limit=512M",
    "validate:strict": "composer validate --strict",
    "check": [
      "@validate:strict",
      "@test",
      "@test:performance",
      "@lint",
      "@analyze"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}
